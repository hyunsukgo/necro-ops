# ─────────────────────────────────────────────
# Necro-Ops environment configuration
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────

# Application mode: "demo" uses only mock connectors (default)
# "live" enables real connectors when their credentials are present
NECRO_MODE=demo

# ── Datadog ──────────────────────────────────
# Enable by providing both keys
DATADOG_API_KEY=
DATADOG_APP_KEY=
# Optional: defaults to "datadoghq.com"
DATADOG_SITE=

# ── Kubernetes ───────────────────────────────
# Enable by providing the path to a kubeconfig file
KUBECONFIG=

# ── Terraform ────────────────────────────────
# Enable by providing a directory that contains terraform state/plan JSON files
TERRAFORM_STATE_DIR=

# ── Slack ─────────────────────────────────────
# Enable by providing a bot token and the channel ID to search
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# ── Amazon Bedrock (LLM) ──────────────────────
# Leave blank to use the template-based autopsy fallback
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# ── Database ──────────────────────────────────
# Defaults to ./necro-ops.db in the project root
DATABASE_URL=./necro-ops.db

# ── Collection window padding (minutes) ───────
WINDOW_PAD_BEFORE=30
WINDOW_PAD_AFTER=15
